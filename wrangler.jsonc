{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coin-market-game",
  "main": "src.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "coin-market-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
